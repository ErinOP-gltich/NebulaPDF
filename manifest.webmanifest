{
  "name": "NebulaPDF",
  "short_name": "NebulaPDF",
  "description": "25 PDF tools that run entirely on your device: merge, compress, convert, edit, sign and protect PDFs without uploading them.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#05060A",
  "theme_color": "#05060A",
  "icons": [
    { "src": "assets/app-icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/app-icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "assets/app-icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/pdf": [".pdf"] } }
  ]
}
